  // Recetas explícitas. Las 120 armas normales tienen receta generada por nivel (ver "tiers").
  // Ingredientes: { "weapon": id } un arma concreta; { "tier": n, "planet": p } cualquier arma de ese nivel y planeta;
  // { "res": clave, "amount": n } un recurso del libro contable.
  "recipes": [
    { "id": "fusion_pendulo", "output": "pendulo_resonancia", "kind": "fusion", "stations": ["altar", "yunque"],
      "description": "GDD 15.3: Daga de Sal Oxidada + Campana de Bronce (botín de la segunda región) + Almita de Espectro.",
      "inputs": [ { "weapon": "daga_1_a" }, { "weapon": "campana_2_b" }, { "res": "mat.almita_espectro", "amount": 1 },
                  { "res": "almitas", "amount": 15000 } ] },
    { "id": "fusion_reloj", "output": "reloj_eclipse", "kind": "fusion", "stations": ["altar"],
      "description": "GDD 15.3: Péndulo de Resonancia + cuatro armas Astrales de Sol, Luna, Marte y Saturno.",
      "inputs": [ { "weapon": "pendulo_resonancia" }, { "tier": 4, "planet": "sol" }, { "tier": 4, "planet": "luna" },
                  { "tier": 4, "planet": "marte" }, { "tier": 4, "planet": "saturno" },
                  { "res": "quintaesencia.saturno", "amount": 5 }, { "res": "almitas", "amount": 120000 } ] }
  ],
  // Altar del Árbol: refinación de sal (GDD 11.1: "se refinan en el Altar del Árbol con Sal Cruda y almitas").
  "refining": {
    "destilada": { "from": 5, "almitas": 1000 },      // TUNING: 5 Sal Cruda + 1 000 almitas = 1 Sal Destilada
    "quintaesencia": { "from": 5, "almitas": 5000 }   // TUNING: 5 Sal Destilada + 5 000 almitas = 1 Quintaesencia
  },
  "reforge": {
    "almitasPerTier": 3000,   // TUNING: almitas × nivel del arma
    "saltPerTier": 2           // TUNING: Sal Cruda del planeta del arma × nivel
  },
