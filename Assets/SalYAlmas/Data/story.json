              ] },
            { "id": "c4", "text": "Las guardias te vieron. Sus ojos ya no tienen a nadie adentro.",
              "battle": { "enemies": ["recuerdo_atrapado", "corteza_hueca"], "strength": 0.55, "next": "c5" } },
            { "id": "c5", "speaker": "Topacia", "portrait": "topo", "text": "Debajo del patio hay túneles más viejos que la fortaleza. Por ahí llegamos a la capitana sin pasar por sus puertas." }
          ]
        },
        {
          "id": "aries_4", "name": "La capitana Ferrán", "description": "Enfrentar a quien manda la Casa en estos montes.", "start": "d1",
          "rewards": { "res": { "almitas": 10000, "sales_de_bano": 80 } },
          "scenes": [
            { "id": "d1", "speaker": "Ferrán", "text": "Una contadora. Pensé que mandarían a una santa. Dime, ¿cuántos de los míos valen uno de los tuyos? Tú eres quien lleva las cuentas.",
              "battle": { "enemies": ["lenador_hueco"], "strength": 0.4, "boss": true, "next": "d2" } },
            { "id": "d2", "speaker": "Ferrán", "text": "Está bien. Termina. Pero sabe esto: el Carnero que me dieron no es un signo. Lo sentí mirar a través de mí. Algo me usaba de ventana.", "effects": { "paralaje": 10 },
              "choices": [
                { "text": "Perdonarla y dejarla ir", "stat": "encanto", "need": 5, "effects": { "marks": ["perdono_capitana"], "title": "perdon_de_hierro" }, "next": "d3" },
                { "text": "Quitarle el mando y entregarla a Valdehierro", "effects": { "marks": ["entrego_capitana"], "souls": 5 }, "next": "d4" }
              ] },
            { "id": "d3", "speaker": "Marisal", "portrait": "marisal", "text": "Si vuelve a pisar una mina, te la cobro a ti. ¿Te queda claro? Bien. Estas cuentas también son tuyas.", "next": "d5" },
            { "id": "d4", "speaker": "Marisal", "portrait": "marisal", "text": "El pueblo decidirá. Eso no te limpia las manos, pero te las deja ocupadas en otra cosa.", "next": "d5" },
            { "id": "d5", "text": "Sobre la fortaleza, entre las estrellas de Aries, hay una que no estaba en los mapas de nadie. Parpadea cuando dejas de mirarla." }
          ]
        },
        {
          "id": "aries_5", "name": "Lo que queda en la mina", "description": "Cerrar la herida de los Montes.", "start": "e1",
          "rewards": { "res": { "almitas": 12000, "sales_de_bano": 160, "quintaesencia.marte": 1 } },
          "scenes": [
            { "id": "e1", "text": "En el fondo del tiro principal la sal forma una catedral. Las voces ya no son voces de mineros. Son más viejas.",
              "variants": [ { "when": { "marks": ["saco_veinte"] }, "text": "Vuelves con los veinte a tu espalda. No los trajiste. Te siguieron. En el fondo del tiro principal la sal forma una catedral, y las voces ya no son voces de mineros: son más viejas." } ],
              "next": "e2" },
            { "id": "e2", "text": "De la pared se desprende algo que tiene forma de ave y no la ha entendido del todo.",
              "battle": { "enemies": ["ave_eclipse", "viento_salino"], "strength": 0.6, "next": "e3" } },
            { "id": "e3", "speaker": "Marisal", "portrait": "marisal", "text": "Esto es sal sin refinar de hace siglos. Si la dejamos, se la lleva otra Casa. Si la digerimos, nos volvemos ellas. Tú eres quien sabe hacer cuentas.",
              "choices": [
                { "text": "Refinarla toda y liberar las almas", "effects": { "marks": ["refino_aries"], "souls": -20, "paralaje": 5 }, "next": "e4" },
                { "text": "Enterrarla otra vez bajo los Montes", "effects": { "marks": ["enterro_aries"] }, "next": "e4" },
                { "text": "Escuchar lo que dicen antes de decidir", "when": { "minParalaje": 15 }, "effects": { "marks": ["escucho_aries"], "paralaje": 12, "souls": -5 }, "next": "e5" }
              ] },
            { "id": "e4", "speaker": "Marisal", "portrait": "marisal", "text": "Listo. Hazte la que no le pesa. Yo me quedo una noche más, y mañana a ver qué camino agarra tu Tortuga." },
            { "id": "e5", "speaker": "Libro Mayor", "text": "Cuentan una temporada. Cuentan una cosecha. Cuentan algo que crece del otro lado del cielo. Al final de la columna, en una letra que no es la tuya, está escrito tu nombre, y luego tachado.", "next": "e4" }
          ]
        }
      ]
    },
    {
      "id": "capricornio", "sign": "capricornio", "name": "Salinas de Obsidiana", "theme": "Salinas, obsidiana y cacao", "echo": "Escila y Caribdis",
      "missions": [
        {
          "id": "cap_1", "name": "La caravana de Zapotitlán", "description": "Los remolinos de sal se tragan las caravanas.", "start": "f1",
          "rewards": { "res": { "almitas": 6000, "sales_de_bano": 80 } },
          "scenes": [
            { "id": "f1", "text": "Las salinas se abren como espejos negros hasta donde alcanza la vista. Huele a cacao tostado y a tormenta. Tras las pozas, dos columnas de sal giran sin moverse de sitio.",
              "variants": [
                { "when": { "marks": ["primera_aries"] }, "text": "Del hierro rojo a la obsidiana. Aquí nadie ha oído de la Casa de Aries, pero ya vieron el eclipse, y te miran como si lo hubieras traído en la caravana. Tras las pozas, dos columnas de sal giran sin moverse de sitio." },
                { "when": { "marks": ["perdono_capitana"] }, "text": "En la entrada de las salinas hay una soldada sin insignia que sirve cacao a las remeras. Es Ferrán. Te saluda con la taza y no dice nada. Tras las pozas, dos columnas de sal giran sin moverse de sitio." }
              ],
              "next": "f2" },
            { "id": "f2", "speaker": "Cempa", "portrait": "cempa", "text": "¡Mira nomás! Otra alma perdida. No te preocupes, yo cobro barato. Te llevo al otro lado de las pozas por un favor que todavía no se me ocurre.",
              "battle": { "enemies": ["corneja", "cristalizado"], "strength": 0.5, "next": "f3" } },
            { "id": "f3", "speaker": "Cempa", "portrait": "cempa", "text": "Bien, sabes contar. Pero sé honesta contigo: ¿confías en una coyota que te cobra por adelantado?",
              "choices": [
                { "text": "Pagarle el favor por adelantado", "effects": { "marks": ["confio_cempa"] }, "next": "f4" },
                { "text": "Descubrirle la trampa y negociar", "stat": "calculo", "need": 5, "effects": { "marks": ["descubrio_cempa"] }, "next": "f4" }
              ] },
            { "id": "f4", "speaker": "Cempa", "portrait": "cempa", "text": "Ay, me caes bien. Eso nunca le ha salido barato a nadie." }
          ]
        },
        {
          "id": "cap_2", "name": "Las dos bocas", "description": "Entender los remolinos antes de cruzarlos.", "start": "g1",
          "rewards": { "res": { "almitas": 7000, "sal_cruda.saturno": 5 } },
          "scenes": [
            { "id": "g1", "text": "Las remeras de sal cruzan entre las columnas en barcas de obsidiana. Una se llama la Boca Vieja y se traga barcas. La otra, la Boca Nueva, se traga a la gente y deja las barcas.", "next": "g2" },
            { "id": "g2", "speaker": "Topacia", "portrait": "topo", "text": "Por abajo giran al revés. Puedo oírlo. No son remolinos: alguien está sorbiendo.", "effects": { "paralaje": 6 }, "next": "g3" },
            { "id": "g3", "text": "Algo sube por la orilla, con los ojos llenos de sal.",
              "battle": { "enemies": ["savia_errante", "larva"], "strength": 0.52, "next": "g4" } },
            { "id": "g4", "speaker": "Cempa", "portrait": "cempa", "text": "La Casa de Capricornio cobra un tributo: una barca de cada cinco para la Boca Vieja. Así las demás pasan. Dicen que son matemáticas. Tú dirás.",
              "choices": [
                { "text": "Pedir ver las cuentas de la Casa", "stat": "calculo", "need": 6, "effects": { "marks": ["vio_cuentas"], "paralaje": 3 } },
                { "text": "Hablar con las remeras", "stat": "encanto", "need": 5, "effects": { "marks": ["hablo_remeras"] } },
                { "text": "Cruzar sin preguntar", "effects": { "marks": ["cruzo_sin_preguntar"], "souls": 10 } }
              ] }
          ]
