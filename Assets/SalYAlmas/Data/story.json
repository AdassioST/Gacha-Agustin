      "missions": [
        {
          "id": "prologo", "name": "El alma que se cayó", "description": "Despiertas en un río de leche que ya no corre.", "start": "p1",
          "rewards": { "witch": "topo", "title": "salada_nacimiento", "res": { "almitas": 5000 } },
          "scenes": [
            { "id": "p1", "text": "Despiertas con la boca llena de sal. El río que te trajo se detuvo aquí: leche blanca, cuajada, que cruje bajo tus manos. Arriba, muy lejos, hay un árbol más alto que el cielo.", "next": "p2" },
            { "id": "p2", "speaker": "Muertita", "portrait": "zarigueya", "text": "No te levantes de golpe, {nombre}. Sí, ya sé cómo te llamas. Está escrito en el aire, encima de tu cabeza. Nadie más puede leerlo, y por eso vas a ser un problema.", "next": "p3", "effects": { "witch": "zarigueya" } },
            { "id": "p3", "speaker": "Libro Mayor", "text": "FOLIO SIN NÚMERO. Nombre: {nombre}. Signo: {signo}. Carta: ninguna. Almas digeridas: 0. Esta entrada no debería existir.", "next": "p4" },
            { "id": "p4", "speaker": "Marisal", "portrait": "marisal", "text": "Alguien más viene. Esa figura de sal todavía susurra. Tú no sabes pelear, ¿verdad? Entonces dinos en qué orden. Dicen que los de tu clase ven los golpes antes de que caigan.",
              "battle": { "enemies": ["figura_sal"], "team": ["marisal", "zarigueya", "topo"], "strength": 0.45, "tutorial": true, "next": "p5" } },
            { "id": "p5", "speaker": "Topacia", "portrait": "topo", "text": "Dos golpes cayeron juntos. Lo oí desde abajo de la tierra. Vente con nosotras: la Tortuga pasa por aquí al anochecer, y tiene agua caliente.", "next": "p6" },
            { "id": "p6", "speaker": "Marisal", "portrait": "marisal", "text": "Yo sigo mi camino. Pero a ver si es cierto lo que dices de las Termas. La sal se te pega hasta en los recuerdos." }
          ]
        }
      ]
    },
    {
      "id": "aries", "sign": "aries", "name": "Montes de Hierro Rojo", "theme": "Fortalezas sobre minas de sal", "echo": "Los cícones",
      "missions": [
        {
          "id": "aries_1", "name": "Humo sobre la mina", "description": "La Casa de Aries saquea las minas de sal.", "start": "a1",
          "rewards": { "res": { "almitas": 6000, "sales_de_bano": 80 } },
          "scenes": [
            { "id": "a1", "text": "Las torres de hierro rojo salen de la montaña como dientes. Abajo arde el pueblo de Valdehierro, y la gente carga costales de sal hacia las carretas de la Casa de Aries.",
              "variants": [
                { "when": { "marks": ["primera_capricornio"] }, "text": "Todavía traes obsidiana en las botas. Aquí la sal es roja y huele a fragua. Abajo arde el pueblo de Valdehierro, y la gente carga costales hacia las carretas de la Casa de Aries. Alguien en la plaza ya habla de la caravana que volvió de los remolinos." },
                { "when": { "marks": ["salvo_remeros"] }, "text": "En la plaza de Valdehierro hay una mujer con el remo roto de las Salinas al hombro. Te reconoce antes de que la veas. «Fuiste quien eligió a los remeros», dice. «Aquí también hay que elegir». Abajo, los costales de sal suben a las carretas de la Casa de Aries." }
              ],
              "next": "a2" },
            { "id": "a2", "speaker": "Marisal", "portrait": "marisal", "text": "Otra vez. Cada invierno vienen, y cada invierno juran que es la última mina. Ayúdame a llegar a la boca del tiro antes que sus perros.",
