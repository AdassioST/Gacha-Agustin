# Unity (el proyecto de la Fase 1 vive en la raíz del repositorio)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/Assets/AssetStoreTools*

# Archivos generados por Unity y los IDE
.vs/
.vscode/
.idea/
.gradle/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Compilaciones móviles
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# Pruebas del núcleo con dotnet (Tests/Core.Tests). Sus .csproj sí se versionan:
# no los genera Unity, son los que compilan el núcleo fuera del motor.
!/Tests/**/*.csproj
/Tests/**/bin/
/Tests/**/obj/
/Tests/**/TestResults/

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Ajustes locales de Claude Code
.claude/settings.local.json

# Python
__pycache__/

# Capturas de revisión de la interfaz (UiCapture); la evidencia que vale se copia a docs/interfaz
/capturas/

# Temporales de las compilaciones de Unity
/.utmp/
