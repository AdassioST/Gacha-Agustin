<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Pruebas del núcleo con dotnet test. Comparte las pruebas de Assets/SalYAlmas/Tests/EditMode
    (las mismas corren dentro de Unity en el Test Runner) y agrega las que solo tienen sentido fuera de Unity.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Core.Tests</AssemblyName>
    <RootNamespace>SalYAlmas.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Core.Lib/SalYAlmas.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../../Assets/SalYAlmas/Tests/EditMode/**/*.cs" Exclude="../../Assets/SalYAlmas/Tests/EditMode/Unity/**/*.cs" />
  </ItemGroup>
</Project>
